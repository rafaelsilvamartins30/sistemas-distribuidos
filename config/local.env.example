# Credenciais e parâmetros locais usados por scripts/k8s-up.sh (Kubernetes) e scripts/compose-up.sh (Docker Compose)
# Copie para .env na raiz (ignorado pelo Git) se quiser personalizar valores ou ativar GEMINI_API_KEY.

# Kubernetes (kind)
UNIR_K8S_PORT=18080
UNIR_KIND_CLUSTER=unir-local

# Docker Compose (sem Kubernetes)
WEB_PORT=15173
ADMIN_WEB_PORT=15175
GATEWAY_PORT=18084
KEYCLOAK_PORT=18081
MAILPIT_PORT=18025
RABBITMQ_UI_PORT=15672
QDRANT_PORT=16333
AI_RAG_PORT=18090

# Modo inicial e senha padrão das contas locais (demo | clean)
UNIR_SEED_MODE=demo
UNIR_DEMO_PASSWORD=123

DB_PASSWORD=unir-local-only
KEYCLOAK_DB_PASSWORD=keycloak-local-only
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only

RABBITMQ_USERNAME=unir
RABBITMQ_PASSWORD=unir-local-only

MONGODB_USERNAME=unir
MONGODB_PASSWORD=unir-local-only

RAG_SYNC_TOKEN=unir-rag-sync-local-only
RAG_SYNC_CLIENT_ID=unir-rag-sync
RAG_SYNC_CLIENT_SECRET=unir-rag-client-local-only
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Opcional: preencha com sua chave do Google AI Studio para ativar geração LLM (gemini-3.5-flash) no Assistente RAG.
# Sem esta chave, o Assistente funciona em modo FALLBACK_RETRIEVAL_ONLY (somente busca vetorial no Qdrant).
GEMINI_API_KEY=
