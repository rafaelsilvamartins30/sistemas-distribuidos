# ==============================================================================
# UNIR — Global .gitignore (multi-stack: TS/Node, Java, Ruby, Go, Rust, Python)
# ==============================================================================

# --- OS & Editors ---
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.fleet/

# --- Local Secrets, Credentials & Environment Overrides ---
/.env
.env.local
.env.*.local
/config/local-demo-accounts.json
/config/.local-demo-accounts-*
*.pem
*.key

# --- Logs, Temp & Local Caches ---
/.cache/
*.log
*.tmp
*.bak
*.orig
*.pid

# --- Node.js / pnpm / TypeScript / Vite / Keycloakify ---
node_modules/
.pnpm-store/
dist/
dist-test/
dist_keycloak/
*.tsbuildinfo
coverage/
.vite/

# --- Java / Maven (gateway, engagement) ---
*.class
*.jar
*.war
*.ear
target/
hs_err_pid*
replay_pid*
.mvn/timing.properties

# --- Ruby / Rails (campus) ---
campus/log/*
!campus/log/.keep
campus/tmp/*
!campus/tmp/.keep
campus/storage/*
!campus/storage/.keep
campus/db/*.sqlite3
campus/db/*.sqlite3-*
.bundle/

# --- Go (payment) ---
payment/bin/
*.test
*.out

# --- Rust / Cargo (access) ---
access/target/

# --- Python / uv / pytest / ruff (ai-rag) ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
